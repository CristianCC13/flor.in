---
import Layout from "../../layouts/Layout.astro";

const projects = [
  {
    name: "IndexLab",
    url: "https://indexlab.ro",
    desc: "SEO agency focused on technical SEO, content strategy, and AI search optimization for SaaS & startups.",
    tags: ["SEO", "Agency", "Service Business"],
  },
  {
    name: "flor.in",
    url: "https://flor.in",
    desc: "My personal corner of the internet. Portfolio, writing, and experiments in building in public.",
    tags: ["Personal", "Astro", "Cloudflare Pages"],
  },
];
---

<Layout title="Projects — Florin">
  <article class="space-y-12">
    <header>
      <h1 class="text-3xl font-bold tracking-tight">Projects</h1>
    </header>

    <section class="space-y-8">
      {projects.map((p) => (
        <div class="border-b border-border pb-8 last:border-0">
          <div class="flex items-baseline justify-between">
            <h2 class="text-xl font-semibold">{p.name}</h2>
            <a href={p.url} class="text-sm text-muted-foreground hover:text-foreground underline underline-offset-4">
              {p.url.replace("https://", "")} &nearr;
            </a>
          </div>
          <p class="mt-2 text-muted-foreground leading-relaxed">{p.desc}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {p.tags.map((t) => (
              <span class="text-xs rounded-md border border-border px-2 py-0.5 text-muted-foreground">{t}</span>
            ))}
          </div>
        </div>
      ))}
    </section>
  </article>
</Layout>