---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="space-y-8">
    <div>
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        Florin
      </h1>
      <p class="mt-4 text-xl text-muted-foreground">
        SEO builder & founder. I build things that rank.
      </p>
    </div>

    <p class="text-lg leading-relaxed text-muted-foreground">
      Founder of <a href="https://indexlab.ro" class="font-medium text-foreground underline underline-offset-4 hover:text-muted-foreground">indexlab.ro</a> — an SEO agency helping companies grow organic traffic.
      I write about building in public, SEO experiments, and tools I create.
    </p>

    <div class="flex items-center gap-4 pt-2">
      <a href="/about" class="text-sm font-medium text-foreground underline underline-offset-4 hover:text-muted-foreground">
        About me &rarr;
      </a>
      <a href="/projects" class="text-sm font-medium text-foreground underline underline-offset-4 hover:text-muted-foreground">
        Projects &rarr;
      </a>
      <a href="/contact" class="text-sm font-medium text-foreground underline underline-offset-4 hover:text-muted-foreground">
        Get in touch &rarr;
      </a>
    </div>
  </section>
</Layout>