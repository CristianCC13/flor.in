---
import Layout from "../../layouts/Layout.astro";

const posts = [
  {
    title: "Coming soon",
    date: "2025-07-16",
    excerpt: "I'll be writing about building in public, SEO experiments, and tools I create. Stay tuned.",
    slug: "coming-soon",
  },
];
---

<Layout title="Blog — Florin">
  <article class="space-y-12">
    <header>
      <h1 class="text-3xl font-bold tracking-tight">Blog</h1>
      <p class="mt-2 text-muted-foreground">Building in public. SEO experiments. Lessons learned.</p>
    </header>

    <section class="space-y-8">
      {posts.map((post) => (
        <div class="border-b border-border pb-8 last:border-0">
          <time class="text-sm text-muted-foreground" datetime={post.date}>
            {new Date(post.date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
          </time>
          <h2 class="mt-1 text-xl font-semibold">{post.title}</h2>
          <p class="mt-2 text-muted-foreground leading-relaxed">{post.excerpt}</p>
          <a href={`/blog/${post.slug}`} class="mt-3 inline-block text-sm font-medium underline underline-offset-4 hover:text-muted-foreground">
            Read &rarr;
          </a>
        </div>
      ))}
    </section>
  </article>
</Layout>