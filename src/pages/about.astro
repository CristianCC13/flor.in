---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "SEO strategist & founder of IndexLab. Writing about search, growth experiments, and building in public.",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			I'm Florin — SEO strategist and founder of <a class="cactus-link" href="https://indexlab.ro" target="_blank" rel="noreferrer">IndexLab</a>, where I help businesses grow through search.
		</p>
		<p>
			This site is my personal space. Here I publish long-form articles with SEO analyses, growth experiments, and industry opinions — plus shorter notes with observations, links, and ideas that don't need a full article.
		</p>
		<h2>What I write about</h2>
		<ul class="list-inside list-disc" role="list">
			<li>SEO strategy and technical deep-dives</li>
			<li>Growth experiments and what I've learned from them</li>
			<li>Building products and tools in public</li>
			<li>The intersection of search, content, and product</li>
		</ul>
		<h2>Elsewhere</h2>
		<ul class="list-inside list-disc" role="list">
			<li><a class="cactus-link" href="https://indexlab.ro" target="_blank" rel="noreferrer">IndexLab</a> — my SEO agency</li>
			<li><a class="cactus-link" href="https://github.com/CristianCC13" target="_blank" rel="noreferrer">GitHub</a></li>
		</ul>
	</div>
</PageLayout>
